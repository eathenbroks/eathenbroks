---
layout: base.njk
title: "Home"
pagination:
  data: collections.posts
  size: 6
  alias: posts
  addAllPagesToCollections: true
---
<h1>تازہ ترین پوسٹیں</h1>
<div class="row">
{% for post in posts %}
  <div class="col-md-6 mb-3">
    <div class="card h-100">
      {% if post.data.featured_image %}
      <img src="{{ post.data.featured_image }}" class="card-img-top" alt="{{ post.data.title }}" loading="lazy">
      {% endif %}
      <div class="card-body">
        <h5 class="card-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h5>
        <p class="card-text"><small class="text-muted">{{ post.date | dateFormat }}</small></p>
        {% if post.data.tags %}
        <p>
          {% for tag in post.data.tags %}<span class="badge bg-secondary ms-1">{{ tag }}</span>{% endfor %}
        </p>
        {% endif %}
        <p>{{ post.templateContent | striptags | truncate(150) }}</p>
      </div>
    </div>
  </div>
{% endfor %}
</div>

<!-- Pagination links -->
<nav>
  <ul class="pagination justify-content-center">
    {% if pagination.href.previous %}
    <li class="page-item"><a class="page-link" href="{{ pagination.href.previous }}">پچھلا</a></li>
    {% endif %}
    {% for pageEntry in pagination.pages %}
    <li class="page-item{% if page.url == pageEntry.url %} active{% endif %}">
      <a class="page-link" href="{{ pageEntry.url }}">{{ loop.index }}</a>
    </li>
    {% endfor %}
    {% if pagination.href.next %}
    <li class="page-item"><a class="page-link" href="{{ pagination.href.next }}">اگلا</a></li>
    {% endif %}
  </ul>
</nav>
